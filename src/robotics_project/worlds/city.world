    <!-- Sidewalk left -->
    <model name="sidewalk_left">
      <static>true</static>
      <pose>15.0 7.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>50.0 3.0 0.1</size></box></geometry>
