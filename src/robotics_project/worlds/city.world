<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="city_world">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main road -->
    <model name="road">
      <static>true</static>
      <pose>10.0 0.0 0.001 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30.0 12.0 0.001</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30.0 12.0 0.001</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Road center yellow line -->
    <model name="center_line">
      <static>true</static>
      <pose>10.0 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>30.0 0.2 0.001</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Road left white line -->
    <model name="left_line">
      <static>true</static>
      <pose>10.0 5.5 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>30.0 0.15 0.001</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Road right white line -->
    <model name="right_line">
      <static>true</static>
      <pose>10.0 -5.5 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>30.0 0.15 0.001</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sidewalk left -->
    <model name="sidewalk_left">
      <static>true</static>
      <pose>10.0 7.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30.0 3.0 0.1</size></box></geometry>
